    {
      "id": "example.ghost_phase_mob.ghost_forrest",
      "displayName": "Ghost Forrest Phase Mob",
      "runtimeFactory": "createEnemy",
      "baseArchetype": "ghost_phaser.ghost_forrest",
      "construct": "example.construct.ghost_phaser_sculpted",
      "patterns": ["example.ghost_phase_homing_radial"],
      "zone": "GhostForrest",
      "entry": { "kind": "airStrafe", "direction": "roadForward", "speed": 82, "warningLeadSeconds": 1.2 },
      "palette": { "core": "#d7fbff", "armor": "#8fa6ff", "gun": "#f3f0b8", "phase": "#bff5ff", "shadow": "rgb(0 0 0 / 0.12)" },
      "presentation": {
        "variant": "ghostWraith"
      },
      "movementProfiles": [
        { "id": "phased-flight", "kind": "phase", "target": "player", "duration": 4.6, "minZ": 24, "maxZ": 120, "amplitude": 42, "frequency": 0.23 },
        { "id": "random-drift", "kind": "flyStrafe", "target": "player", "speed": 95, "minZ": 60, "maxZ": 140, "amplitude": 64, "frequency": 0.37 }
      ],
      "phase": {
        "defaultState": "phasedOut",
        "phasedOutMostOfTime": true,
        "intangibleWhenOutOfPhase": true,
        "weaponPassThrough": "most",
        "mustPhaseInToFire": true,
        "phaseInBeforeFireSeconds": 1,
        "phaseOutAfterLastShotSeconds": 1,
        "onHit": {
          "cancelFireSequence": true,
          "phaseOutDelayFrames": 4,
          "phaseOutDurationFrames": 4,
          "teleport": "randomVisibleLocation",
          "teleportAfterFullPhaseOut": true
        }
      },
      "fireSequence": {
        "pattern": "example.ghost_phase_homing_radial",
        "shots": 16,
        "sequential": true,
        "cancelOnHit": true,
        "phaseOutAfterCompleteSeconds": 1
      },
      "cellAnimations": [
        { "selector": "all", "kind": "phaseFade", "frequency": 0.22, "opacityMin": 0.14, "opacityMax": 0.86 },
        { "selector": "type:armor", "kind": "fabricWeave", "amplitude": 14, "frequency": 1.2, "phaseOffset": 0.55, "opacityMin": 0.25, "opacityMax": 0.72 }
      ],
      "editable": ["construct", "patterns", "entry", "palette", "movementProfiles", "phase", "fireSequence", "cellAnimations"]
    },
